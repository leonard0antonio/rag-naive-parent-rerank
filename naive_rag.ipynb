   "source": [
    "# Naive RAG para \"Os Sertões\" - Euclides da Cunha\n",
    "\n",
    "Este notebook implementa uma abordagem **Naive RAG** (Retrieval-Augmented Generation) básica para responder perguntas sobre o livro \"Os Sertões\".\n",
    "\n",
    "## Estrutura do Naive RAG:\n",
    "1. **Download e extração de texto** do PDF\n",
    "2. **Chunking simples** - divisão em pedaços de tamanho fixo\n",
    "3. **Embeddings** - geração de vetores usando sentence-transformers\n",
    "4. **Vector Store** - armazenamento em FAISS\n",
    "5. **Retrieval** - busca por similaridade de cosseno\n",
    "6. **Generation** - geração de resposta com LLM usando contexto recuperado"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Instalação de dependências\n",
    "!pip install -q pypdf sentence-transformers faiss-cpu langchain-openai langchain-community langchain-text-splitters tiktoken python-dotenv tqdm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import requests\n",
    "from pathlib import Path\n",
    "\n",
    "# Download do PDF\n",
    "pdf_url = \"https://fundar.org.br/wp-content/uploads/2021/06/os-sertoes.pdf\"\n",
    "pdf_path = Path(\"os-sertoes.pdf\")\n",
    "\n",
    "if not pdf_path.exists():\n",
    "    print(\"Baixando PDF...\")\n",
    "    response = requests.get(pdf_url, stream=True)\n",
    "    response.raise_for_status()\n",
    "    with open(pdf_path, \"wb\") as f:\n",
    "        for chunk in response.iter_content(chunk_size=8192):\n",
    "            f.write(chunk)\n",
    "    print(f\"PDF salvo em: {pdf_path.absolute()}\")\n",
    "else:\n",
    "    print(f\"PDF já existe em: {pdf_path.absolute()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extração de texto do PDF\n",
    "from pypdf import PdfReader\n",
    "\n",
    "reader = PdfReader(\"os-sertoes.pdf\")\n",
    "full_text = \"\"\n",
    "\n",
    "for i, page in enumerate(reader.pages):\n",
    "    text = page.extract_text()\n",
    "    if text:\n",
    "        full_text += f\"\\n--- PÁGINA {i+1} ---\\n\" + text\n",
    "\n",
    "print(f\"Total de páginas: {len(reader.pages)}\")\n",
    "print(f\"Total de caracteres: {len(full_text):,}\")\n",
    "print(f\"Primeiros 500 caracteres:\\n{full_text[:500]}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Chunking simples (Naive) - divisão por tamanho fixo\n",
    "from langchain_text_splitters import RecursiveCharacterTextSplitter\n",
    "\n",
    "text_splitter = RecursiveCharacterTextSplitter(\n",
    "    chunk_size=1000,\n",
    "    chunk_overlap=200,\n",
    "    length_function=len,\n",
    "    separators=[\"\\n\\n\", \"\\n\", \". \", \" \", \"\"]\n",
    ")\n",
    "\n",
    "chunks = text_splitter.split_text(full_text)\n",
    "\n",
    "print(f\"Número de chunks: {len(chunks)}\")\n",
    "print(f\"Tamanho médio: {sum(len(c) for c in chunks) // len(chunks)} caracteres\")\n",
    "print(f\"\\nExemplo do primeiro chunk:\\n{chunks[0][:300]}...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Geração de embeddings\n",
    "from sentence_transformers import SentenceTransformer\n",
    "import numpy as np\n",
    "\n",
    "# Modelo multilíngue bom para português\n",
    "model = SentenceTransformer('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2')\n",
    "\n",
    "print(\"Gerando embeddings...\")\n",
    "embeddings = model.encode(chunks, show_progress_bar=True, batch_size=32)\n",
    "\n",
    "print(f\"Shape dos embeddings: {embeddings.shape}\")\n",
    "print(f\"Tipo: {embeddings.dtype}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Criação do Vector Store com FAISS\n",
    "import faiss\n",
    "\n",
    "dimension = embeddings.shape[1]\n",
    "index = faiss.IndexFlatIP(dimension)  # Inner Product (similaridade de cosseno com vetores normalizados)\n",
    "\n",
    "# Normalizar embeddings para usar Inner Product como cosseno\n",
    "faiss.normalize_L2(embeddings)\n",
    "index.add(embeddings.astype('float32'))\n",
    "\n",
    "print(f\"Índice FAISS criado com {index.ntotal} vetores\")\n",
    "\n",
    "# Salvar índice e chunks para uso posterior\n",
    "faiss.write_index(index, \"naive_rag_index.faiss\")\n",
    "import pickle\n",
    "with open(\"naive_rag_chunks.pkl\", \"wb\") as f:\n",
    "    pickle.dump(chunks, f)\n",
    "\n",
    "print(\"Índice e chunks salvos.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Função de busca (retrieval)\n",
    "def retrieve(query, k=5):\n",
    "    \"\"\"Busca os k chunks mais similares à query.\"\"\"\n",
    "    query_embedding = model.encode([query])\n",
    "    faiss.normalize_L2(query_embedding)\n",
    "    scores, indices = index.search(query_embedding.astype('float32'), k)\n",
    "    \n",
    "    results = []\n",
    "    for score, idx in zip(scores[0], indices[0]):\n",
    "        if idx < len(chunks):\n",
    "            results.append({\n",
    "                'chunk': chunks[idx],\n",
    "                'score': float(score),\n",
    "                'index': int(idx)\n",
    "            })\n",
    "    return results\n",
    "\n",
    "# Teste de busca\n",
    "test_query = \"visão de Euclides da Cunha sobre o sertão\"\n",
    "results = retrieve(test_query, k=3)\n",
    "\n",
    "for i, r in enumerate(results):\n",
    "    print(f\"\\n--- Resultado {i+1} (score: {r['score']:.4f}) ---\")\n",
    "    print(r['chunk'][:200] + \"...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configuração do LLM para geração\n",
    "import os\n",
    "from langchain_openai import ChatOpenAI\n",
    "from langchain_core.prompts import ChatPromptTemplate\n",
    "from langchain_core.output_parsers import StrOutputParser\n",
    "\n",
    "# Configure sua API key do OpenAI\n",
    "# os.environ[\"OPENAI_API_KEY\"] = \"sua-chave-aqui\"\n",
    "\n",
    "llm = ChatOpenAI(model=\"gpt-4o-mini\", temperature=0.1)\n",
    "\n",
    "prompt_template = ChatPromptTemplate.from_template(\"\"\"\n",
    "Você é um especialista na obra \"Os Sertões\" de Euclides da Cunha.\n",
    "Responda à pergunta baseando-se APENAS no contexto fornecido abaixo.\n",
    "Se a informação não estiver no contexto, diga que não encontrou a informação.\n",
    "\n",
    "Contexto:\n",
    "{context}\n",
    "\n",
    "Pergunta: {question}\n",
    "\n",
    "Resposta:\n",
    "\"\"\")\n",
    "\n",
    "chain = prompt_template | llm | StrOutputParser()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Função completa de RAG\n",
    "def naive_rag(question, k=5):\n",
    "    \"\"\"Pipeline completo Naive RAG.\"\"\"\n",
    "    # Retrieval\n",
    "    results = retrieve(question, k=k)\n",
    "    context = \"\\n\\n\".join([r['chunk'] for r in results])\n",
    "    \n    # Generation\n",
    "    answer = chain.invoke({\n",
    "        \"context\": context,\n",
    "        \"question\": question\n",
    "    })\n",
    "    \n    "return {\n",
    "        \"answer\": answer,\n",
    "        \"sources\": results\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Perguntas do desafio\n",
    "questions = [\n",
    "    \"Qual é a visão de Euclides da Cunha sobre o ambiente natural do sertão nordestino e como ele influencia a vida dos habitantes?\",\n",
    "    \"Quais são as principais características da população sertaneja descritas por Euclides da Cunha? Como ele relaciona essas características com o ambiente em que vivem?\",\n",
    "    \"Qual foi o contexto histórico e político que levou à Guerra de Canudos, segundo Euclides da Cunha?\",\n",
    "    \"Como Euclides da Cunha descreve a figura de Antônio Conselheiro e seu papel na Guerra de Canudos?\",\n",
    "    \"Quais são os principais aspectos da crítica social e política presentes em \\\"Os Sertões\\\"? Como esses aspectos refletem a visão do autor sobre o Brasil da época?\"\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Executar RAG para todas as perguntas\n",
    "results = {}\n",
    "\n",
    "for i, q in enumerate(questions, 1):\n",
    "    print(f\"\\n{'='*80}\")\n",
    "    print(f\"PERGUNTA {i}: {q}\")\n",
    "    print(f\"{'='*80}\")\n",
    "    \n",
    "    result = naive_rag(q, k=5)\n",
    "    results[f\"q{i}\"] = result\n",
    "    \n",
    "    print(f\"\\nRESPOSTA:\\n{result['answer']}\")\n",
    "    print(f\"\\nFONTES ({len(result['sources'])} chunks):\")\n",
    "    for j, src in enumerate(result['sources']):\n",
    "        print(f\"  {j+1}. Score: {src['score']:.4f} - {src['chunk'][:100]}...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Salvar resultados\n",
    "import json\n",
    "\n",
    "output = {}\n",
    "for key, val in results.items():\n",
    "    output[key] = {\n",
    "        \"question\": questions[int(key[1])-1],\n",
    "        \"answer\": val[\"answer\"],\n",
    "        \"sources\": [\n",
    "            {\"score\": s[\"score\"], \"chunk_preview\": s[\"chunk\"][:200]}\n",
    "            for s in val[\"sources\"]\n",
    "        ]\n",
    "    }\n",
    "\n",
    "with open(\"naive_rag_results.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(output, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "print(\"Resultados salvos em naive_rag_results.json\")"
   ]
  }
 ],
